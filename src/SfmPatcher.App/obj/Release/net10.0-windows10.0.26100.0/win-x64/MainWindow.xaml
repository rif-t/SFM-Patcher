<Window x:Class="SfmPatcher.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SFM-Patcher">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="38" Height="38" CornerRadius="8" Background="Transparent"><Image Source="Assets/ModernSFMPatcher.jpg" Stretch="UniformToFill"/></Border>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="SFM-Patcher" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Graphics setup for Source Filmmaker" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='25' x:Name="GamePathBox" PlaceholderText="SFM game folder containing sfm.exe"                                      />
            <Button x:ConnectionId='26' x:Name="BrowseButton" Grid.Column="1" Content="Browse"                           />
        </Grid>
        <TabView Grid.Row="2">
            <TabViewItem Header="Info">
                <ScrollViewer><StackPanel MaxWidth="960" HorizontalAlignment="Center" Padding="36" Spacing="24">
                    <TextBlock Text="About" FontSize="32" FontWeight="SemiBold"/>
                    <Border Padding="32" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="20">
                            <TextBlock Text="SFM-Patcher" FontSize="24" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="104" Height="104" CornerRadius="52" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Image Source="Assets/SkibidiKitty.jpg" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Skibidi Kitty" FontSize="24" FontWeight="SemiBold"/>
                                    <TextBlock Text="SFM-Patcher creator" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8BD;" FontSize="16"/>
                                <TextBlock Text="Discord: skibidi_kitty" FontSize="17" VerticalAlignment="Center"/>
                            </StackPanel>
                            <HyperlinkButton NavigateUri="https://www.youtube.com/@HaVocAnimation" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE714;" FontSize="16"/>
                                    <TextBlock Text="YouTube: HaVocAnimation" FontSize="17"/>
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Graphics">
                <ScrollViewer><StackPanel MaxWidth="760" HorizontalAlignment="Center" Padding="20" Spacing="18">
                    <TextBlock Text="Render setup" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Choose the x86 versions to install. Latest refreshes from upstream when you check for updates." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock Text="ReShade version" FontWeight="SemiBold"/><ComboBox x:ConnectionId='18' x:Name="ReShadeVersionBox" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="DXVK version" FontWeight="SemiBold"/><ComboBox x:ConnectionId='19' x:Name="DxvkVersionBox" HorizontalAlignment="Stretch"/>
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:ConnectionId='23' x:Name="InstallButton" Content="Install graphics setup"                             Style="{ThemeResource AccentButtonStyle}"/><Button x:ConnectionId='24' Content="Check for updates"                                 /></StackPanel>
                            <ProgressBar x:ConnectionId='20' x:Name="Progress" Visibility="Collapsed" IsIndeterminate="True"/>
                            <TextBlock x:ConnectionId='21' x:Name="StatusText" Text="Loading available versions…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button x:ConnectionId='22' x:Name="UninstallButton" Content="Uninstall graphics setup"                               HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Shaders">
                <Grid RowSpacing="10" Padding="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Choose ReShade effects to install" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Choose packages or expand them to select individual effects. Selected files download from the latest upstream repository version. Depth-based effects still require ReShade to see a valid SFM depth buffer." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:ConnectionId='13' x:Name="CheckAllShadersButton" Content="Check all"                                    />
                            <Button x:ConnectionId='14' x:Name="UncheckAllShadersButton" Content="Uncheck all"                                      />
                            <Button x:ConnectionId='15' x:Name="RefreshShadersButton" Content="Refresh list"                                   />
                            <Button x:ConnectionId='16' x:Name="InstallShadersButton" Content="Install selected"                                    Style="{ThemeResource AccentButtonStyle}"/>
                            <Button x:ConnectionId='17' x:Name="RestoreShadersButton" Content="Restore shader backup"                                   />
                        </StackPanel>
                        <ProgressBar x:ConnectionId='11' x:Name="ShaderProgress" Visibility="Collapsed" IsIndeterminate="True"/>
                        <TextBlock x:ConnectionId='12' x:Name="ShaderStatusText" Text="Loading ReShade effect packages…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:ConnectionId='10' x:Name="ShaderPackagesPanel" Spacing="8"/>
                    </ScrollViewer>
                </Grid>
            </TabViewItem>
            <TabViewItem Header="Addons">
                <ScrollViewer><StackPanel MaxWidth="760" HorizontalAlignment="Center" Padding="20" Spacing="18">
                    <TextBlock Text="ReShade add-ons" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Install REST Enhanced (ReShadeEffectShaderToggler) for SFM’s 32-bit ReShade instance." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="14"><TextBlock Text="REST Enhanced version" FontWeight="SemiBold"/><ComboBox x:ConnectionId='5' x:Name="RestVersionBox" HorizontalAlignment="Stretch"/>
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:ConnectionId='7' x:Name="InstallRestButton" Content="Install add-on"                                 Style="{ThemeResource AccentButtonStyle}"/><Button x:ConnectionId='8' Content="Check for updates"                                 /><Button x:ConnectionId='9' x:Name="RestoreRestButton" Content="Restore add-on backup"                                /></StackPanel>
                            <TextBlock x:ConnectionId='6' x:Name="RestStatusText" Text="Available versions load from GitHub." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Presets">
                <ScrollViewer><StackPanel MaxWidth="760" HorizontalAlignment="Center" Padding="20" Spacing="18">
                    <TextBlock Text="ReShade presets" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Install a preset and its required extra files. Supporting shaders and textures are installed only when you choose that preset." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Skibidi Kitty" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="My own global illumination and advanced AO shader." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:ConnectionId='3' x:Name="InstallPresetButton" Content="Install preset"                                   Style="{ThemeResource AccentButtonStyle}"/>
                                <Button x:ConnectionId='4' x:Name="RestorePresetButton" Content="Restore preset and shader files"                                  />
                            </StackPanel>
                            <TextBlock x:ConnectionId='2' x:Name="PresetStatusText" Text="Choose a valid SFM folder to install this preset." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabViewItem>
        </TabView>
        <TextBlock Grid.Row="3" Text="Close SFM before installing or restoring. Existing ReShade profiles are preserved." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Window>

